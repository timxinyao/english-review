# English Learning Tool — API 常驻服务（Fastify + tsx 直跑）
# 安装：cp deploy/systemd/*.service /etc/systemd/system/ && systemctl daemon-reload
[Unit]
Description=English Learning API (Fastify)
After=network.target

[Service]
WorkingDirectory=/opt/english-learning/app/apps/api
ExecStart=/opt/english-learning/app/node_modules/.bin/tsx src/index.ts
EnvironmentFile=/etc/english-learning/env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
