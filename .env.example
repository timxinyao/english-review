# ---- API（apps/api）----
PORT=5174
HOST=127.0.0.1
NODE_ENV=development

# 会话签名密钥（生产必须更换，>=32 字符）
SESSION_SECRET=dev-only-change-me-0123456789abcdef

# 访问密码（二选一；HASH 优先。HASH 格式：<hex盐>:<hex哈希>，scrypt）
AUTH_PASSWORD=dev-password
# AUTH_PASSWORD_HASH=

# SQLite 路径（相对 apps/api）
DATABASE_PATH=./data/dev.db

# 允许的跨站 Origin（修改型接口校验；逗号分隔）
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 用户本地时区（session_date / 热力图归属）
APP_TIMEZONE=Asia/Shanghai

# ---- 备份（可选）----
# 不设置 = 本地备份模式（snapshots/ 日备 30 天 + 月备 12 个月自动轮转）
# 设置 = S3 异地容灾模式（aws-cli 凭证走 IAM 角色或 aws configure）
S3_BUCKET=

# ---- GLM（Anthropic Messages 兼容端点）----
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/anthropic
# 模型别名（留空=自动从 /v1/models 选最新：flash 取最高版本 *flash*，air/max 取最高版本主模型）
# 指定即固定使用该型号
GLM_MODEL_FLASH=
GLM_MODEL_AIR=
GLM_MODEL_MAX=
GLM_MAX_TOKENS=8192
# 思考强度：留空=按任务策略（判定/批改 low，生成 off）；可强制 off/low/high/max
GLM_THINKING=
