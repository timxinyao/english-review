{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "tests", "e2e", "playwright.config.ts", "vite.config.ts"],
  // src/sw.ts 是 Service Worker 源码（WebWorker lib 与 DOM lib 冲突），由 tsconfig.sw.json 单独类型检查
  "exclude": ["src/sw.ts"]
}
