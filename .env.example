# ---- API（apps/api）----
PORT=5174
HOST=127.0.0.1
NODE_ENV=development

# 会话签名密钥（生产必须更换，>=32 字符）
SESSION_SECRET=dev-only-change-me-0123456789abcdef

# 访问密码（二选一；HASH 优先。HASH 格式：<hex盐>:<hex哈希>，scrypt）
AUTH_PASSWORD=dev-password
# AUTH_PASSWORD_HASH=

# SQLite 路径（相对 apps/api）
DATABASE_PATH=./data/dev.db

# 允许的跨站 Origin（修改型接口校验；逗号分隔）
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 用户本地时区（session_date / 热力图归属）
APP_TIMEZONE=Asia/Shanghai

# ---- GLM ----
GLM_API_KEY=
GLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL_FLASH=glm-4-flash
GLM_MODEL_AIR=glm-4-air
GLM_MODEL_MAX=glm-4-plus
# 是否使用 response_format=json_object
GLM_JSON_MODE=true
