{
  "name": "@el/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:e2e": "tsx scripts/e2e-server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "job:prefetch": "tsx src/jobs/daily-prefetch.ts",
    "job:cleanup": "tsx src/jobs/weekly-cleanup.ts",
    "job:backup": "tsx src/jobs/daily-backup.ts",
    "job:maintenance": "tsx src/jobs/monthly-maintenance.ts",
    "ai:eval": "tsx scripts/ai-eval.ts"
  },
  "dependencies": {
    "@el/shared": "workspace:*",
    "@fastify/cookie": "^11.0.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.3",
    "fastify": "^5.0.0",
    "ts-fsrs": "^5.4.2",
    "web-push": "^3.6.7",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
